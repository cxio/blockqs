{
    "user_id": "hello-x",           // 节点身份ID（站群成员适用）
    "serve_port": 8899,             // 对外服务端口
    "txdata_dir": "./_txdata",      // 交易数据存储根目录
    "utxco_dir": "./_utxo7utco",    // UTXO/UTCO 本地缓存根目录
    "blocks_dir": "./_blocks",      // 区块存档根目录
    "log_level": "info",            // 日志级别，支持：debug, info, warn, error
    "log_root": "./_logs",          // 日志存储根路径

    // 当前区块链的收益地址
    "stake_address": "cx:...Base58check"
}
